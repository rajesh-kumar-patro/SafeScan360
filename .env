# SafeScan360 camera
CAMERA_RTSP_URL="rtsp://admin:Gate@123@192.168.1.5:554/cam/realmonitor?channel=1&subtype=1"
RTSP_TRANSPORT=tcp



# Multi-worker tracking
TRACK_PPE_ABSENCE_FRAMES=6
TRACK_IDENTITY_CONFIRM_FRAMES=2
TRACK_FACE_INTERVAL_FRAMES=3



# Person detection for live tracking (best.pt has no "person" class)
# PERSON_MODEL=yolov8n.pt      # auto-downloaded on first run if not in the project root
PERSON_CONFIDENCE=0.35
PERSON_IMG_SIZE=640
TRACK_MAX_LOST_FRAMES=15
TRACK_MIN_HITS=1

# Sign Up / Sign In: how long a login stays valid (hours). Logout ends it immediately.
AUTH_SESSION_HOURS=12







# =========================================================
# SafeScan360 - Email Alerts
# =========================================================

ALERT_EMAIL_TO="safescan360@gmail.com"

SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465
SMTP_USERNAME="safescan360@gmail.com"
SMTP_PASSWORD="nzajcqkvmhkopupo"


# =========================================================
# Detection Settings
# =========================================================

PPE_CONFIDENCE=0.25
FIRE_CONFIDENCE=0.25
SMOKE_CONFIDENCE=0.25

IMG_SIZE=416
FRAME_SKIP=1

LIVE_FPS=8
LIVE_JPEG_QUALITY=80

MAX_UPLOAD_SIZE_MB=500

DEVICE=auto

ALERT_COOLDOWN_SECONDS=10
INCIDENT_RETENTION_HOURS=24

# PPE must remain continuously missing for this duration
# before an alert is generated.
CONTINUOUS_VIOLATION_SECONDS=2


